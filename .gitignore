# --- Tư liệu hình tải về (tải lại theo archive.json / assets-licenses.md) ---
episodes/*/archive/*.jpg
episodes/*/archive/*.jpeg
episodes/*/archive/*.png
episodes/*/archive/*.tif*
episodes/*/art-in/
episodes/*/art-cut/
episodes/*/art-ready/
!episodes/*/art-brief/

